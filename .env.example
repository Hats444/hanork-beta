# Copie para .env e preencha. Nunca commite o .env real.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=hanork_bot
TELEGRAM_ADMIN_IDS=
# Compra de licenca/VIP so no Telegram. Username do bot pra montar t.me/xxx?start=comprar
# Afiliado: dias de VIP por venda indicada (default 3)
# HANORK_AFFILIATE_DAYS=3
# Auto-divulgacao do PROPRIO bot (so sessoes admin TG): /autodivbot on
# HANORK_AUTODIVBOT_QTD=3
# Divulgacao padrao so pras contas em TELEGRAM_ADMIN_IDS (trocavel no Zap):
# HANORK_DIV_PRICE=R$250
# HANORK_DIV_STORE_URL=
# HANORK_DIV_CMD=.comprar
# Grupo oficial do convite dinamico ({{groupInviteLink}}). Ou .divulgar setgrupo no Zap.
# HANORK_DIV_INVITE_GROUP=
# Fallback se o bot nao for admin e groupInviteCode der forbidden:
# HANORK_DIV_INVITE_URL=
# Cache curto do invite code em ms (default 8000)
# HANORK_DIV_INVITE_CACHE_MS=8000
MAX_SESSIONS=30
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_LINK=

# APIs
# Duck (consultas auxiliares) — token completo do painel Duck
DUCK_API_TOKEN=
# CheckData (consultas CPF/nome/placa/tel) — token do painel checkdata.vip
CHECKDATA_API_BASE=https://checkdata.vip
CHECKDATA_API_TOKEN=
# Painel extra (consultas dossie). Nunca commite senha/cookie.
# Turnstile (login automatico na VPS) — opcoes GRATIS (sem cartao):
#   A) SolverCF — 1000 solves / 7 dias: solvercf.com/free-trial -> SOLVERCF_API_KEY
#   B) NSLSolver — 100 solves apos confirmar e-mail: nslsolver.com -> NSLSOLVER_API_KEY
#   C) EzSolver no SEU PC (Chrome, ilimitado local): github.com/ismoiloffS/EzSolver
#      python service.py (porta 8191) + tunel ngrok -> MIND7_EZSOLVER_URL=https://xxx.ngrok.app
# Cookie do PC nao funciona na VPS (IP diferente). Capsolver/2Captcha = pagos.
# Painel extra (Mind7): OFF por padrao. Liga so com solver com saldo na VPS.
# MIND7_ENABLED=1
MIND7_ENABLED=0
# Modo seguro: kick so com antiatk*/antilinkHard (antistatus so apaga). 0 = legado
HANORK_SAFE_KICK=1
# Anti-roubo: default ON no grupo (antiadmin+revert). Com antiadmin ON, demote automatico. 0 = so audita
HANORK_ANTIROUBO_AUTO_REVERT=1
# Relatorio diario no TG (admins) hora BRT; 0 desliga
HANORK_DAILY_REPORT=1
HANORK_DAILY_REPORT_HOUR=9
# Backup diario do SQLite (BRT). 0 desliga. Hook opcional copia fora do host ({file}/{dir})
HANORK_DB_BACKUP=1
HANORK_DB_BACKUP_HOUR=3
HANORK_DB_BACKUP_KEEP_DAYS=14
# HANORK_DB_BACKUP_HOOK=
# 2o fator host* (PIN no comando). Vazio = so platform_admin. Nunca commitar o valor real.
# HANORK_HOST_OPS_SECRET=
# Alertas TG (sessao caiu / fila / taxa erro). 0 desliga
HANORK_OPS_ALERTS=1
HANORK_OPS_SESSION_DOWN_MIN=5
HANORK_OPS_QUEUE_ALERT=80
HANORK_OPS_ERR_RATE=0.4
HANORK_OPS_ALERT_COOLDOWN_MS=900000
# Postgres (destino de escala). Vazio = so SQLite. Dual-write nao troca leitura.
# HANORK_PG_URL=
# DATABASE_URL=
HANORK_PG_DUAL_WRITE=0
HANORK_PG_POOL=4
# Leitura: sqlite (padrao) | pg (cutover; fallback SQLite se miss/erro)
HANORK_DB_DRIVER=sqlite
# Intent NLU executa via Universal Router (1=on). 0 = path legado getCommand.execute
HANORK_INTENT_VIA_ROUTER=1
# Aviso VIP D-3/D-1 (hora BRT); 0 desliga
HANORK_VIP_EXPIRY_WARN=1
HANORK_VIP_WARN_HOUR=10
# Quota diaria consultas (VIP=40, dono=500, admin ilimitado). 0 desliga
HANORK_CONSULTA_QUOTA=1
HANORK_CONSULTA_VIP_DAILY=40
HANORK_CONSULTA_OWNER_DAILY=500
# Alerta TG a cada N grupos DIV falhando seguidos
HANORK_DIV_FAIL_ALERT=5
# Antiporno: OFF por padrao (API NSFW do provedor). 1 liga
HANORK_ANTIPORNO=0
MIND7_BASE=https://mind-7.org
MIND7_EMAIL=
MIND7_PASSWORD=
MIND7_COOKIE=
SOLVERCF_API_KEY=
NSLSOLVER_API_KEY=
MIND7_EZSOLVER_URL=
NOPECHA_API_KEY=
CAPSOLVER_API_KEY=
TWO_CAPTCHA_KEY=
# Hanork API (consultas / downloads / antiporno)
# Preferir HANORK_*; ZEROTWO_* continua valido (compat)
HANORK_API_KEY=
HANORK_API_BASE=
ZEROTWO_API_KEY=
ZEROTWO_API_BASE=https://zero-two-apis.store

# Ollama / Web Intelligence
# Na Raikken o sidecar (llama.cpp + Qwen2.5-Coder 0.5B) sobe sozinho se OLLAMA_SIDECAR=1.
# 3B oficial nao cabe nos 1536 MiB da egg.
OLLAMA_ENABLED=1
OLLAMA_SIDECAR=1
OLLAMA_SIDECAR_CTX=1024
OLLAMA_SIDECAR_THREADS=2
# .osint: interpretacao sempre ON (Ollama local, senao pool). Independente do Intent.
OSINT_OLLAMA=1
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=hanork-brain
OLLAMA_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=60000
# Intent NLU: modelo SEMPRE em RAM (-1) + ping periodico (so se OLLAMA_ENABLED=1)
OLLAMA_KEEP_ALIVE=-1
OLLAMA_HEARTBEAT_MS=480000
OLLAMA_INTENT_TIMEOUT=12000
OLLAMA_INTENT_COLD_TIMEOUT=45000
OLLAMA_WARMUP_TIMEOUT=180000
OLLAMA_INTENT_COOLDOWN_MS=12000

# Intent Router — pool Zero Two (round-robin; mesma HANORK_API_KEY / ZEROTWO_API_KEY)
INTENT_ZT_RPM=55
INTENT_CIRCUIT_FAILS=3
INTENT_CIRCUIT_COOLDOWN_MS=30000
INTENT_HARD_COOLDOWN_MS=600000
INTENT_MAX_REMOTE_TRIES=6
INTENT_SECOND_PASS_TRIES=8
INTENT_CACHE_TTL_MS=90000
INTENT_THROTTLE_DELAY_MS=1200
SEARCH_TIMEOUT=15000
FETCH_TIMEOUT=15000
MAX_QUERIES=3
MAX_RESULTS_PER_QUERY=10
MAX_PAGES_TO_FETCH=5
SEARCH_SESSION_TTL=1800000
MAX_CONTENT_CHARS=1200

# Status de grupo (.statuspost / .postbandeja modo membros): 1 = skmsg so membros
# (admin nao entra na cifra). 0 = todo mundo ve, inclusive admin.
# Divulgacao de status de grupo IGNORA isso e posta status NORMAL (todo mundo ve).
HANORK_STATUS_HIDE_ADMIN=1

# .paypost / pay da DIV (mode membros): mesma entrega do statuspost
# (meta so membros + sender-key nova + 1 skmsg). Proto continua oi.json.
# HANORK_PAY_DIRECTED=1 volta ao pkmsg por membro (live 06/09: Zap nao pintou).
# HANORK_PAY_DIRECTED=0

# Lista nativa / botoes do Zap. Default ON. So 0 desliga na host (emergencia).
# Dono da sessao liga/desliga com .buttonson / .buttonsoff (VIP/adm nao mudam).
# HANORK_NATIVE_MENU=1

# Intent Router (deteccao automatica sem prefixo)
# INTENT defaults tambem em config do usuario (intentRouter)
# allowSearch=false por padrao (evita falso positivo)

# Canal oficial WhatsApp (auto-follow + modo OFF encaminhada)
# WHATSAPP_CANAL_ID=120363426498125446@newsletter
# WHATSAPP_CANAL_NAME=STICKERS E FIGURINHAS
# WHATSAPP_CANAL_LINK=https://whatsapp.com/channel/0029VbCKGmz1yT25HFMuiT0t
# Site publico (botao 2 da DIV se nao houver demo)
HANORK_SITE_URL=https://hats444.github.io
# Convite do grupo DEMO (botao 2 da DIV). Se vazio, usa o site.
# HANORK_DEMO_INVITE_URL=
# Comissao afiliado na primeira compra paga (day pass / Pro / Enterprise)
# HANORK_AFFILIATE_RATE=0.3
# Intervalo minimo 30000ms (default 300000 = 5 min)
CANAL_CHECK_INTERVAL_MS=300000

# Health / filas
HEALTH_PORT=3847
HEALTH_HOST=127.0.0.1
HANORK_EXEC_CONCURRENCY=10
HANORK_EXEC_PENDING_MAX=100
HANORK_JOB_CONCURRENCY=5
HANORK_JOB_PENDING_MAX=200
# Teto de mencoes no blast CTA/texto (commands/divulgar/div.js — nao mexe no job)
# HANORK_DIV_MENTION_CAP=80
# Teto de mencoes do .cita (default 500; WA corta perto disso)
# HANORK_CITA_MENTION_CAP=500
# HANORK_SECURITY_EVENTS_MAX_AGE_DAYS=30
# RAM do egg (host ~1536MB). Pair novo recusa se RSS >= 70% do limite.
# HANORK_RSS_LIMIT_MB=1536
# HANORK_RSS_PAIR_PCT=70
# HANORK_RSS_SOFT_MB=980
# HANORK_RSS_HARD_MB=1180
# Janela de erro/cmd no /health (minutos via ms)
# HANORK_CMD_STATS_WINDOW_MS=3600000
# Snapshot SQL 1x/dia em data/backups (guarda 3 dias). Sem .env/sessoes.

# 1 = bot so responde TELEGRAM_ADMIN e o chip do dono. User comum/VIP ficam mudos.
# Protecao de grupo continua. Tokens de pagamento nao devem ficar na host.
# HANORK_OWNER_ONLY=0

# 1 = cobra plano nos comandos pagos. 0 = Telegram/Zap abertos (user conecta e usa).
# HANORK_PAYWALL=0
# HANORK_PAYWALL_AT=2026-08-30T03:00:00.000Z

# Teto do termo de busca (play/google/ytsearch/spotify...). Link http(s) usa URL_MAX.
# HANORK_SEARCH_QUERY_MAX=100
# HANORK_SEARCH_URL_MAX=500

# Auto-revelar visu unica → PV do chip (so TELEGRAM_ADMIN; nunca no grupo)
HANORK_AUTO_REVELAR=1
HANORK_AUTO_REVELAR_GROUP=
# HANORK_AUTO_REVELAR_GAP_MS=700
# HANORK_AUTO_REVELAR_LIVE_MS=1800000
# HANORK_AUTO_REVELAR_OWNERS=0
# (auto-visu manda so pro chip; dono recebe via crl/reply). So roda em TELEGRAM_ADMIN.
# HANORK_AUTO_REVELAR_BACKFILL_DELAY_MS=120000

# Mercado Pago (VIP automatico — nunca commite o token)
# MP_ACCESS_TOKEN=COLOQUE_AQUI   (ou TEST-... no sandbox)
# TOKEN_MP=
# MP_WEBHOOK_SECRET=
# MP_PUBLIC_URL=https://seu-host
# MP_SANDBOX=0
# PIX_AUTO_POLL=1
# PIX_AUTO_POLL_INTERVAL_MS=30000
# MP_ALLOW_UNSIGNED_WEBHOOK=0
# Sem HTTPS publico o poll e o caminho. Unsigned so com MP_SANDBOX=1.
# MP_ENFORCE_IP=0
# MP_PAYER_EMAIL=
# MP_STATEMENT_DESCRIPTOR=HANORK

# Redis / Bull (T5) — opcional em local; obrigatorio no docker-compose
REDIS_URL=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
ENABLE_BULL=0

# Moderação anti-flood
MOD_FLOOD_THRESHOLD=5
MOD_FLOOD_WINDOW_MS=10000
# Anti-admin (X9 / anti-roubo) — limiares default; cada grupo pode mudar no comando
HANORK_ANTIADMIN_THRESHOLD=5
HANORK_ANTIADMIN_WINDOW_MS=10000
HANORK_ANTIADMIN_LOCK_MS=8000
# 1 = loga evento/autor/alvo/decisao/acao do anti-roubo (sem tokens)
GROUP_SECURITY_DEBUG=0

# Twilio / email (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=
EMAIL_FROM=

# OSINT etico (dono) — coleta passiva. 0 = apaga evidencias apos o relatorio
OSINT_RETENTION_MS=0
OSINT_COLLECTOR_GAP_MS=8000
# Busca Brave opcional (sem chave = DuckDuckGo html + wiki)
# HANORK_SEARCH_KEY=
# Opcional: aumenta rate do GitHub publico (nunca commitar o valor)
# GITHUB_TOKEN=

# Zone / SystemZone (scripts importados — so nomes; nunca commitar valor)
ZONE_API_BASE=https://zone.api.br
ZONE_API_KEY=
SYSTEMZONE_API_BASE=https://systemzone.store
SYSTEMZONE_API_KEY=
# Free Fire likes/info (nyxlikesff.store) — 1o provedor do .likeff se preenchido
NYX_FF_TOKEN=
# Ordem do fallback .likeff (default: nyx,freefiremania)
# FF_LIKES_ORDER=nyx,freefiremania
# Provedores extras (JSON). Sem endpoint conhecido, nao inventar.
# FF_LIKES_EXTRA=[{"name":"likesff","baseURL":"https://exemplo","endpoint":"/api/add","method":"POST","idField":"uid","regionField":"region","cooldownMs":21600000}]
# Auto-apresentar: tempo em ms (15s–10min, default 90s)
AUTOAPRESENTAR_MS=90000

# Host / painel Pterodactyl (Client API) — opcional
# Conta → API Credentials. Nunca commit a chave real.
RAIKKEN_PANEL_URL=
RAIKKEN_API_KEY=
RAIKKEN_SERVER_ID=

# Categorias API adultas / apostas: default OFF. 1 liga de novo.
HANORK_NSFW_ENABLED=0
HANORK_CASSINO_ENABLED=0

# Backup diario de data/ (sqlite, users, system). 0 = nao roda.
# HANORK_OFFSITE_BACKUP=1
# HANORK_BACKUP_DIR=/home/container/backups-offsite
# HANORK_BACKUP_RETAIN_DAYS=14
# HANORK_BACKUP_HOUR=4


# Contato e identificadores (nunca commitar valor real)
HANORK_CONTACT_WA=
META_AI_JID=
HANORK_DEMO_GROUP_JID=
HANORK_DEMO_SELLER_JID=
